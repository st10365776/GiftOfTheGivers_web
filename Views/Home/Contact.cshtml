@* Contact details and the main donation call to action. *@
@{
    ViewData["Title"] = "Contact";
}

<section class="section">
    <div class="container">
        <h1>Contact Us</h1>
        <p>We would love to hear from you and help you get involved.</p>
        <a class="btn btn-primary-gift" asp-controller="Home" asp-action="About">About Us</a>
        <a class="btn btn-primary-gift" asp-controller="Donation" asp-action="Index">Donate</a>
        <a class="btn btn-primary-gift" asp-controller="Volunteer" asp-action="Index">Volunteer</a>
    </div>
</section>
