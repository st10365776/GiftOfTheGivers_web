@model IEnumerable<GiftOfTheGivers_web.Models.ReliefProject>
@{ ViewData["Title"] = "Relief Operations"; }
<link rel="stylesheet" href="~/css/employee.css" asp-append-version="true" />
<div class="employee-dashboard"><partial name="_EmployeeSidebar" /><main class="employee-main"><header class="employee-header"><div><p class="employee-page-label">Operations</p><h1>Relief Operations</h1><p class="employee-welcome">Create and update humanitarian projects.</p></div></header><div class="employee-panel"><h2>Add / Edit Operation</h2><form asp-action="SaveReliefOperation" method="post" class="operation-form">@Html.AntiForgeryToken()<input type="hidden" name="ProjectID" value="0"/><input name="ProjectName" placeholder="Project name" required/><input name="Location" placeholder="Location"/><input name="StartDate" type="date"/><input name="EndDate" type="date"/><select name="Status"><option>Planning</option><option>Active</option><option>Attention</option><option>Completed</option></select><textarea name="Description" placeholder="Description"></textarea><button class="employee-primary-button" type="submit">Save Operation</button></form></div><div class="employee-panel"><h2>Operations (@Model.Count())</h2><div class="table-wrapper"><table class="employee-table"><thead><tr><th>Project</th><th>Location</th><th>Start</th><th>End</th><th>Status</th></tr></thead><tbody>@foreach(var p in Model){<tr><td><strong>@p.ProjectName</strong><span class="donor-email">@p.Description</span></td><td>@p.Location</td><td>@p.StartDate?.ToString("dd MMM yyyy")</td><td>@p.EndDate?.ToString("dd MMM yyyy")</td><td><span class="status @p.Status.ToLowerInvariant()">@p.Status</span></td></tr>}@if(!Model.Any()){<tr><td colspan="5">No relief operations found.</td></tr>}</tbody></table></div></div></main></div>
