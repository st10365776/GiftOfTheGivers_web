@model IReadOnlyList<GiftOfTheGivers_web.Models.ContactSubmission>
@{
    ViewData["Title"] = "Contact Messages";
}

<div class="employee-dashboard">
    <partial name="_EmployeeSidebar" />

    <main class="employee-main">
        <header class="employee-header">
            <div>
                <p class="employee-page-label">Admin Inbox</p>
                <h1>Contact Messages</h1>
                <p class="employee-welcome">Messages submitted through the public contact form.</p>
            </div>
        </header>

        <div class="employee-panel">
            <div class="panel-header">
                <h2>Messages (@Model.Count)</h2>
            </div>

            <div class="table-wrapper">
                <table class="employee-table">
                    <thead>
                        <tr>
                            <th>Sender</th>
                            <th>Topic</th>
                            <th>Message</th>
                            <th>Received</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var message in Model)
                        {
                            <tr>
                                <td>
                                    <strong>@message.FirstName @message.LastName</strong>
                                    <span class="donor-email">@message.Email</span>
                                    <span class="donor-email">@message.Phone</span>
                                </td>
                                <td>@message.Subject</td>
                                <td>@message.Message</td>
                                <td>@message.SubmittedAtUtc.ToLocalTime().ToString("dd MMM yyyy HH:mm")</td>
                            </tr>
                        }
                        @if (Model.Count == 0)
                        {
                            <tr>
                                <td colspan="4">No contact messages have been submitted.</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </main>
</div>
