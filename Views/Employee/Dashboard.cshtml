@model GiftOfTheGivers_web.Models.ViewModels.EmployeeDashboardViewModel
@{ ViewData["Title"] = "Employee Dashboard"; }
<link rel="stylesheet" href="~/css/employee.css" asp-append-version="true" />
<div class="employee-dashboard">
<aside class="employee-sidebar">
 <div class="employee-sidebar-brand"><img src="~/images/logo1.png" alt="Gift of the Givers" /></div>
 <nav class="employee-nav">
  <a asp-action="Dashboard" class="employee-nav-link active">▦ <span>Dashboard</span></a>
  <a asp-action="Donations" class="employee-nav-link">R <span>Donations</span></a>
  <a asp-action="Volunteers" class="employee-nav-link">♧ <span>Volunteers</span></a>
  <a asp-action="ReliefOperations" class="employee-nav-link">✚ <span>Relief Operations</span></a>
  <a asp-action="Reports" class="employee-nav-link">▤ <span>Reports</span></a>
  <a asp-action="Settings" class="employee-nav-link">⚙ <span>Settings</span></a>
 </nav>
 <div class="employee-sidebar-bottom"><a asp-controller="Home" asp-action="Index" class="employee-nav-link">← <span>Back to Website</span></a><a asp-action="Logout" class="employee-nav-link">⇥ <span>Sign Out</span></a></div>
</aside>
<main class="employee-main">
<header class="employee-header"><div><p class="employee-page-label">Employee Portal</p><h1>Dashboard</h1><p class="employee-welcome">Welcome back, @User.Identity?.Name.</p></div><div class="employee-profile"><div class="employee-avatar">@((User.Identity?.Name ?? "E")[0])</div><div><strong>@User.Identity?.Name</strong><span>@User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value</span></div></div></header>
<section class="employee-stats">
 <div class="employee-stat-card"><div class="stat-card-top"><span>Total Donations</span><div class="stat-icon">R</div></div><h2>R @Model.TotalDonations.ToString("N2")</h2><p class="stat-positive">From database</p></div>
 <div class="employee-stat-card"><div class="stat-card-top"><span>Donations</span><div class="stat-icon">+</div></div><h2>@Model.DonationCount</h2><p class="stat-positive">Recorded donations</p></div>
 <div class="employee-stat-card"><div class="stat-card-top"><span>Volunteers</span><div class="stat-icon">♧</div></div><h2>@Model.VolunteerCount</h2><p class="stat-positive">Applications received</p></div>
 <div class="employee-stat-card"><div class="stat-card-top"><span>Active Operations</span><div class="stat-icon">●</div></div><h2>@Model.ActiveOperations</h2><p class="stat-warning">@Model.OperationsNeedingAttention require attention</p></div>
</section>
<section class="employee-grid">
<div class="employee-panel"><div class="panel-header"><div><h2>Recent Donations</h2><p>Latest contributions from the database</p></div><a asp-action="Donations" class="panel-link">View All</a></div><div class="table-wrapper"><table class="employee-table"><thead><tr><th>Donor</th><th>Amount</th><th>Type</th><th>Date</th><th>Status</th></tr></thead><tbody>
@foreach(var d in Model.RecentDonations){<tr><td><strong>@(d.IsAnonymous ? "Anonymous" : d.User?.FullName ?? "Guest")</strong><span class="donor-email">@(d.IsAnonymous ? "Donor requested anonymity" : d.User?.Email)</span></td><td>@d.Currency @d.Amount.ToString("N2")</td><td>@d.DonationType</td><td>@d.DonationDate.ToLocalTime().ToString("dd MMM yyyy")</td><td><span class="status @d.Status.ToLowerInvariant()">@d.Status</span></td></tr>}
@if(!Model.RecentDonations.Any()){<tr><td colspan="5">No donations recorded yet.</td></tr>}</tbody></table></div></div>
<div class="employee-panel"><div class="panel-header"><div><h2>Relief Operations</h2><p>Current operations</p></div><a asp-action="ReliefOperations" class="panel-link">View All</a></div><div class="operation-list">
@foreach(var p in Model.RecentOperations){<div class="operation"><div class="operation-icon">+</div><div class="operation-info"><strong>@p.ProjectName</strong><span>@p.Location</span></div><span class="operation-status @p.Status.ToLowerInvariant()">@p.Status</span></div>}
@if(!Model.RecentOperations.Any()){<p>No relief operations recorded yet.</p>}</div></div>
</section>
</main></div>
