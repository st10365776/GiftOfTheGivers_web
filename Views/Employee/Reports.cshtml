@{ ViewData["Title"] = "Reports"; }
<link rel="stylesheet" href="~/css/employee.css" asp-append-version="true" />
<div class="employee-dashboard"><partial name="_EmployeeSidebar" /><main class="employee-main"><header class="employee-header"><div><p class="employee-page-label">Analytics</p><h1>Reports</h1><p class="employee-welcome">Live summary generated from Azure SQL data.</p></div></header><section class="employee-stats"><div class="employee-stat-card"><span>Total Donation Value</span><h2>R @(((decimal)ViewBag.Total).ToString("N2"))</h2></div><div class="employee-stat-card"><span>Completed Donations</span><h2>@ViewBag.Completed</h2></div><div class="employee-stat-card"><span>Pending Donations</span><h2>@ViewBag.PendingDonations</h2></div><div class="employee-stat-card"><span>Pending Volunteers</span><h2>@ViewBag.PendingVolunteers</h2></div></section><div class="employee-panel"><h2>Operations</h2><p>@ViewBag.ActiveProjects active operations out of @ViewBag.Projects total projects.</p></div></main></div>
