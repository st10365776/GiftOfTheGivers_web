@model GiftOfTheGivers_web.Models.Employee
@{ ViewData["Title"] = "Settings"; }
<link rel="stylesheet" href="~/css/employee.css" asp-append-version="true" />
<div class="employee-dashboard"><partial name="_EmployeeSidebar" /><main class="employee-main"><header class="employee-header"><div><p class="employee-page-label">Account</p><h1>Settings</h1><p class="employee-welcome">Update your staff profile and password.</p></div></header>@if(TempData["Message"] != null){<div class="employee-success">@TempData["Message"]</div>}<div class="employee-panel"><form asp-action="Settings" method="post">@Html.AntiForgeryToken()<label>Full Name</label><input asp-for="FullName" required/><label>Email</label><input value="@Model.Email" disabled/><label>Phone Number</label><input asp-for="PhoneNumber"/><label>New Password</label><input type="password" name="newPassword" autocomplete="new-password" placeholder="Leave blank to keep current password"/><button class="employee-primary-button" type="submit">Save Changes</button></form></div></main></div>
