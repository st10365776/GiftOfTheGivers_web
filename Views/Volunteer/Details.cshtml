@{
    ViewData["Title"] = "Volunteer Details";
}

<link rel="stylesheet" href="~/css/volunteer.css" />

<section class="details-hero">

    <div class="details-hero-content">

        <span class="section-label">
            VOLUNTEER PROGRAMME
        </span>

        <h1>
            Become Part of
            <span>Something Bigger.</span>
        </h1>

        <p>
            Volunteers play an important role in helping
            communities during times of need.
        </p>

        <a asp-controller="Volunteer"
           asp-action="Apply"
           class="volunteer-primary-btn">

            <i class="bi bi-person-plus-fill"></i>
            Apply to Volunteer

        </a>

    </div>

</section>


<section class="details-section">

    <div class="details-grid">

        <div class="details-main reveal">

            <span class="section-label">
                ABOUT VOLUNTEERING
            </span>

            <h2>
                How You Can Help
            </h2>

            <p>
                Volunteers can support humanitarian work in
                different ways. Depending on your skills and
                the needs of the community, you may assist with
                relief activities, community programmes,
                donations, logistics and other activities.
            </p>

            <p>
                You do not need to be an expert to make a
                difference. What matters most is your willingness
                to help and work together with others.
            </p>

        </div>


        <div class="details-highlight reveal">

            <div class="highlight-icon">
                <i class="bi bi-heart-fill"></i>
            </div>

            <h3>
                Every Helping Hand Matters
            </h3>

            <p>
                Your time, skills and energy can help someone
                get through a difficult moment.
            </p>

        </div>

    </div>


    <!-- AREAS -->
    <div class="areas-section">

        <div class="volunteer-heading reveal">

            <span class="section-label">
                AREAS OF SUPPORT
            </span>

            <h2>
                Where You Can Help
            </h2>

        </div>


        <div class="areas-grid">

            <div class="area-card reveal">

                <i class="bi bi-box-seam-fill"></i>

                <h3>Relief Distribution</h3>

                <p>
                    Help organise and distribute essential
                    supplies to communities.
                </p>

            </div>


            <div class="area-card reveal">

                <i class="bi bi-truck"></i>

                <h3>Logistics</h3>

                <p>
                    Assist with organising resources and
                    getting them where they are needed.
                </p>

            </div>


            <div class="area-card reveal">

                <i class="bi bi-megaphone-fill"></i>

                <h3>Community Support</h3>

                <p>
                    Help communicate important information
                    and support community activities.
                </p>

            </div>


            <div class="area-card reveal">

                <i class="bi bi-laptop-fill"></i>

                <h3>Administration</h3>

                <p>
                    Help with data, communication and
                    administrative activities.
                </p>

            </div>

        </div>

    </div>


    <!-- REQUIREMENTS -->
    <div class="requirements-section reveal">

        <div class="requirements-icon">
            <i class="bi bi-check-circle-fill"></i>
        </div>

        <div>

            <span class="section-label">
                BEFORE YOU APPLY
            </span>

            <h2>
                What You Need
            </h2>

            <ul>

                <li>
                    <i class="bi bi-check"></i>
                    A willingness to help others
                </li>

                <li>
                    <i class="bi bi-check"></i>
                    Ability to work as part of a team
                </li>

                <li>
                    <i class="bi bi-check"></i>
                    Good communication
                </li>

                <li>
                    <i class="bi bi-check"></i>
                    Commitment to volunteer responsibilities
                </li>

            </ul>

        </div>

    </div>

</section>


<section class="details-bottom-cta reveal">

    <h2>
        Ready to Get Involved?
    </h2>

    <p>
        Start your volunteer journey today.
    </p>

    <a asp-controller="Volunteer"
       asp-action="Apply"
       class="volunteer-primary-btn">

        Apply Now
        <i class="bi bi-arrow-right"></i>

    </a>

</section>


<script>

    const elements =
        document.querySelectorAll(".reveal");

    const observer =
        new IntersectionObserver(
            entries => {

                entries.forEach(entry => {

                    if (entry.isIntersecting) {

                        entry.target.classList.add("active");

                    }

                });

            },
            { threshold: 0.15 }
        );

    elements.forEach(element => {
        observer.observe(element);
    });

</script>
