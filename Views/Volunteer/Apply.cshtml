@model GiftOfTheGivers_web.Models.ViewModels.VolunteerApplicationViewModel

@{
ViewData["Title"] = "Volunteer Application";
}

<link rel="stylesheet"
      href="~/css/volunteer.css"
      asp-append-version="true" />

<section class="application-page">

    <div class="application-header">

        <span class="section-label">
            VOLUNTEER APPLICATION
        </span>

        <h1>
            Let's Get You
            <span>Involved.</span>
        </h1>

        <p>
            Tell us a little about yourself and how you would
            like to help.
        </p>

    </div>

    <!-- PROGRESS -->

    <div class="application-progress">

        <div class="progress-step active">

            <div class="progress-circle">
                1
            </div>

            <span>
                Your Details
            </span>

        </div>

        <div class="progress-line"></div>

        <div class="progress-step">

            <div class="progress-circle">
                2
            </div>

            <span>
                Review
            </span>

        </div>

        <div class="progress-line"></div>

        <div class="progress-step">

            <div class="progress-circle">
                3
            </div>

            <span>
                Complete
            </span>

        </div>

    </div>

    <div class="application-card">

        <form asp-controller="Volunteer"
              asp-action="Confirm"
              method="post">

            @Html.AntiForgeryToken()

            <div asp-validation-summary="ModelOnly"
                 class="text-danger mb-3">
            </div>

            <!-- PERSONAL DETAILS -->

            <div class="form-section-title">

                <div>
                    <i class="bi bi-person-fill"></i>
                </div>

                <div>

                    <h2>
                        Personal Information
                    </h2>

                    <p>
                        Tell us who you are.
                    </p>

                </div>

            </div>

            <div class="application-grid">

                <div class="volunteer-form-group">

                    <label asp-for="FirstName">
                        First Name
                    </label>

                    <div class="volunteer-input">

                        <i class="bi bi-person"></i>

                        <input asp-for="FirstName"
                               placeholder="Enter your first name"
                               required />

                    </div>

                    <span asp-validation-for="FirstName"
                          class="text-danger">
                    </span>

                </div>

                <div class="volunteer-form-group">

                    <label asp-for="LastName">
                        Last Name
                    </label>

                    <div class="volunteer-input">

                        <i class="bi bi-person"></i>

                        <input asp-for="LastName"
                               placeholder="Enter your last name"
                               required />

                    </div>

                    <span asp-validation-for="LastName"
                          class="text-danger">
                    </span>

                </div>

                <div class="volunteer-form-group">

                    <label asp-for="Email">
                        Email Address
                    </label>

                    <div class="volunteer-input">

                        <i class="bi bi-envelope"></i>

                        <input asp-for="Email"
                               type="email"
                               placeholder="you@example.com"
                               required />

                    </div>

                    <span asp-validation-for="Email"
                          class="text-danger">
                    </span>

                </div>

                <div class="volunteer-form-group">

                    <label asp-for="Phone">
                        Phone Number
                    </label>

                    <div class="volunteer-input">

                        <i class="bi bi-telephone"></i>

                        <input asp-for="Phone"
                               type="tel"
                               placeholder="+27 ..."
                               required />

                    </div>

                    <span asp-validation-for="Phone"
                          class="text-danger">
                    </span>

                </div>

            </div>

            <!-- VOLUNTEER INFORMATION -->

            <div class="form-section-title second">

                <div>
                    <i class="bi bi-people-fill"></i>
                </div>

                <div>

                    <h2>
                        Volunteer Information
                    </h2>

                    <p>
                        Tell us how you would like to help.
                    </p>

                </div>

            </div>

            <div class="application-grid">

                <div class="volunteer-form-group">

                    <label asp-for="Area">
                        Area of Interest
                    </label>

                    <div class="volunteer-input">

                        <i class="bi bi-heart"></i>

                        <select asp-for="Area"
                                required>

                            <option value="">
                                Select an area
                            </option>

                            <option value="Relief Distribution">
                                Relief Distribution
                            </option>

                            <option value="Logistics">
                                Logistics
                            </option>

                            <option value="Community Support">
                                Community Support
                            </option>

                            <option value="Administration">
                                Administration
                            </option>

                            <option value="Other">
                                Other
                            </option>

                        </select>

                    </div>

                    <span asp-validation-for="Area"
                          class="text-danger">
                    </span>

                </div>

                <div class="volunteer-form-group">

                    <label asp-for="Availability">
                        Availability
                    </label>

                    <div class="volunteer-input">

                        <i class="bi bi-calendar"></i>

                        <select asp-for="Availability"
                                required>

                            <option value="">
                                Select availability
                            </option>

                            <option value="Weekdays">
                                Weekdays
                            </option>

                            <option value="Weekends">
                                Weekends
                            </option>

                            <option value="Both">
                                Both
                            </option>

                            <option value="Flexible">
                                Flexible
                            </option>

                        </select>

                    </div>

                    <span asp-validation-for="Availability"
                          class="text-danger">
                    </span>

                </div>

            </div>

            <!-- LOCATION -->

            <div class="volunteer-form-group">

                <label asp-for="Location">
                    Location
                </label>

                <div class="volunteer-input">

                    <i class="bi bi-geo-alt"></i>

                    <input asp-for="Location"
                           placeholder="City / Area"
                           required />

                </div>

                <span asp-validation-for="Location"
                      class="text-danger">
                </span>

            </div>

            <!-- ABOUT -->

            <div class="volunteer-form-group">

                <label asp-for="About">
                    Tell Us About Yourself
                </label>

                <div class="volunteer-textarea">

                    <i class="bi bi-pencil"></i>

                    <textarea asp-for="About"
                              rows="5"
                              placeholder="Tell us about your skills, experience or why you would like to volunteer..."
                              required></textarea>

                </div>

                <span asp-validation-for="About"
                      class="text-danger">
                </span>

            </div>

            <!-- CONSENT -->

            <label class="application-consent">

                <input type="checkbox"
                       name="consent"
                       value="true"
                       required />

                <span>
                    I confirm that the information I have
                    provided is correct and I am interested
                    in volunteering.
                </span>

            </label>

            <!-- BUTTONS -->

            <div class="application-buttons">

                <a asp-controller="Volunteer"
                   asp-action="Details"
                   class="back-btn">

                    <i class="bi bi-arrow-left"></i>

                    Back

                </a>

                <button type="submit"
                        class="volunteer-primary-btn">

                    Continue

                    <i class="bi bi-arrow-right"></i>

                </button>

            </div>

        </form>

    </div>

</section>

<script>

    const applicationCard =
        document.querySelector(".application-card");

    if (applicationCard) {
        applicationCard.classList.add("loaded");
    }

</script>

@section Scripts {

<partial name="_ValidationScriptsPartial" />

}