@model GiftOfTheGivers_web.Models.ViewModels.VolunteerApplicationViewModel
@{
    ViewData["Title"] = "Volunteer Application";
}

<link rel="stylesheet" href="~/css/volunteer.css" />

<section class="application-page">

    <div class="application-header">

        <span class="section-label">
            VOLUNTEER APPLICATION
        </span>

        <h1>
            Let's Get You
            <span>Involved.</span>
        </h1>

        <p>
            Tell us a little about yourself and how you would
            like to help.
        </p>

    </div>


    <!-- PROGRESS -->

    <div class="application-progress">

        <div class="progress-step active">

            <div class="progress-circle">
                1
            </div>

            <span>Your Details</span>

        </div>

        <div class="progress-line"></div>

        <div class="progress-step">

            <div class="progress-circle">
                2
            </div>

            <span>Review</span>

        </div>

        <div class="progress-line"></div>

        <div class="progress-step">

            <div class="progress-circle">
                3
            </div>

            <span>Complete</span>

        </div>

    </div>


    <div class="application-card">

        <form asp-controller="Volunteer"
              asp-action="Confirm"
              method="post">

            <!-- PERSONAL DETAILS -->

            <div class="form-section-title">

                <div>
                    <i class="bi bi-person-fill"></i>
                </div>

                <div>

                    <h2>Personal Information</h2>

                    <p>
                        Tell us who you are.
                    </p>

                </div>

            </div>


            <div class="application-grid">

                <div class="volunteer-form-group">

                    <label for="firstName">
                        First Name
                    </label>

                    <div class="volunteer-input">

                        <i class="bi bi-person"></i>

                        <input type="text"
                               id="firstName"
                               asp-for="FirstName"
                               placeholder="Enter your first name"
                               required />

                    </div>

                </div>


                <div class="volunteer-form-group">

                    <label for="lastName">
                        Last Name
                    </label>

                    <div class="volunteer-input">

                        <i class="bi bi-person"></i>

                        <input type="text"
                               id="lastName"
                               asp-for="LastName"
                               placeholder="Enter your last name"
                               required />

                    </div>

                </div>


                <div class="volunteer-form-group">

                    <label for="email">
                        Email Address
                    </label>

                    <div class="volunteer-input">

                        <i class="bi bi-envelope"></i>

                        <input type="email"
                               id="email"
                               asp-for="Email"
                               placeholder="you@example.com"
                               required />

                    </div>

                </div>


                <div class="volunteer-form-group">

                    <label for="phone">
                        Phone Number
                    </label>

                    <div class="volunteer-input">

                        <i class="bi bi-telephone"></i>

                        <input type="tel"
                               id="phone"
                               asp-for="Phone"
                               placeholder="+27 ..."
                               required />

                    </div>

                </div>

            </div>


            <!-- VOLUNTEER INFORMATION -->

            <div class="form-section-title second">

                <div>
                    <i class="bi bi-people-fill"></i>
                </div>

                <div>

                    <h2>Volunteer Information</h2>

                    <p>
                        Tell us how you would like to help.
                    </p>

                </div>

            </div>


            <div class="application-grid">

                <div class="volunteer-form-group">

                    <label for="area">
                        Area of Interest
                    </label>

                    <div class="volunteer-input">

                        <i class="bi bi-heart"></i>

                        <select id="area"
                                asp-for="Area"
                                required>

                            <option value="" selected disabled>
                                Select an area
                            </option>

                            <option>
                                Relief Distribution
                            </option>

                            <option>
                                Logistics
                            </option>

                            <option>
                                Community Support
                            </option>

                            <option>
                                Administration
                            </option>

                            <option>
                                Other
                            </option>

                        </select>

                    </div>

                </div>


                <div class="volunteer-form-group">

                    <label for="availability">
                        Availability
                    </label>

                    <div class="volunteer-input">

                        <i class="bi bi-calendar"></i>

                        <select id="availability"
                                asp-for="Availability"
                                required>

                            <option value="" selected disabled>
                                Select availability
                            </option>

                            <option>
                                Weekdays
                            </option>

                            <option>
                                Weekends
                            </option>

                            <option>
                                Both
                            </option>

                            <option>
                                Flexible
                            </option>

                        </select>

                    </div>

                </div>

            </div>


            <!-- EXPERIENCE -->

            <div class="volunteer-form-group">

                <label for="experience">
                    Tell Us About Yourself
                </label>

                <div class="volunteer-textarea">

                    <i class="bi bi-pencil"></i>

                    <textarea id="experience"
                              name="experience"
                              rows="5"
                              placeholder="Tell us about your skills, experience or why you would like to volunteer..."
                              required></textarea>

                </div>

            </div>


            <!-- CONSENT -->

            <label class="application-consent">

                <input type="checkbox"
                       required />

                <span>
                    I confirm that the information I have
                    provided is correct and I am interested
                    in volunteering.
                </span>

            </label>


            <!-- BUTTONS -->

            <div class="application-buttons">

                <a asp-controller="Volunteer"
                   asp-action="Details"
                   class="back-btn">

                    <i class="bi bi-arrow-left"></i>
                    Back

                </a>

                <button type="submit"
                        class="volunteer-primary-btn">

                    Continue
                    <i class="bi bi-arrow-right"></i>

                </button>

            </div>

        </form>

    </div>

</section>


<script>

    const applicationCard =
        document.querySelector(".application-card");

    if (applicationCard) {

        applicationCard.classList.add("loaded");

    }

</script>
