@* Donation form for choosing frequency, currency, and amount. *@
@model GiftOfTheGivers_web.Models.DonationViewModel

@{
    ViewData["Title"] = "Make a Donation";
}

<section class="donation-page">

    <div class="container">

        <div class="donation-header">

            <span class="hero-label">
                Support Our Work
            </span>

            <h1>Make a Donation</h1>

            <p>
                Your donation helps provide essential humanitarian
                assistance to communities in need.
            </p>

        </div>


        <div class="donation-card">

            <form asp-controller="Donation"
                  asp-action="Index"
                  method="post">

                <h2>How would you like to donate?</h2>

                <div class="donation-type">

                    <button type="button"
                            class="donation-type-btn active"
                            data-type="Once-off">
                        Once-off
                    </button>

                    <button type="button"
                            class="donation-type-btn"
                            data-type="Monthly">
                        Monthly
                    </button>

                </div>

                <input type="hidden"
                       id="donationType"
                       name="DonationType"
                       value="Once-off" />


                <h3>Donation currency</h3>

                <div class="currency-options">

                    <button type="button"
                            class="currency-btn active"
                            data-currency="ZAR">
                        ZAR
                        <span>South African Rand</span>
                    </button>

                    <button type="button"
                            class="currency-btn"
                            data-currency="USD">
                        USD
                        <span>US Dollar</span>
                    </button>

                    <button type="button"
                            class="currency-btn"
                            data-currency="EUR">
                        EUR
                        <span>Euro</span>
                    </button>

                </div>

                <input type="hidden"
                       id="donationCurrency"
                       name="Currency"
                       value="ZAR" />


                <h3>Select amount</h3>

                <div class="donation-amounts">

                    <button type="button"
                            class="amount-btn"
                            data-amount="100">
                        R100
                    </button>

                    <button type="button"
                            class="amount-btn"
                            data-amount="250">
                        R250
                    </button>

                    <button type="button"
                            class="amount-btn"
                            data-amount="500">
                        R500
                    </button>

                    <button type="button"
                            class="amount-btn"
                            data-amount="1000">
                        R1 000
                    </button>

                    <button type="button"
                            class="amount-btn"
                            data-amount="2500">
                        R2 500
                    </button>

                    <button type="button"
                            class="amount-btn"
                            id="customButton">
                        Custom
                    </button>

                </div>

                <input type="hidden"
                       id="donationAmount"
                       name="Amount" />


                <div class="custom-amount"
                     id="customAmountContainer">

                    <label for="customAmount">
                        Custom amount
                    </label>

                    <input type="number"
                           id="customAmount"
                           class="form-control"
                           min="1"
                           placeholder="Enter amount" />

                </div>


                <h3>Payment Method</h3>

                <div class="payment-methods">

                    <label class="payment-option">

                        <input type="radio"
                               name="PaymentMethod"
                               value="Card"
                               checked />

                        <span>
                            Credit / Debit Card
                        </span>

                    </label>


                    <label class="payment-option">

                        <input type="radio"
                               name="PaymentMethod"
                               value="EFT" />

                        <span>
                            EFT
                        </span>

                    </label>

                </div>


                <div class="anonymous-option">

                    <label>

                        <input type="checkbox"
                               name="DonateAnonymously"
                               value="true" />

                        <span>
                            Donate anonymously
                        </span>

                    </label>

                    <p>
                        Your name will not be displayed publicly
                        as a donor.
                    </p>

                </div>


                <div class="donation-summary">

                    <div>
                        <span>Donation</span>
                        <strong id="summaryAmount">
                            R0
                        </strong>
                    </div>

                    <div>
                        <span>Frequency</span>
                        <strong id="summaryType">
                            Once-off
                        </strong>
                    </div>

                </div>


                <div class="donation-action">

                    <button type="submit"
                            class="btn btn-donate-continue">
                        Continue
                    </button>

                </div>

            </form>

        </div>

    </div>

</section>