@model GiftOfTheGivers_web.Models.ViewModels.DonationViewModel

@{
    ViewData["Title"] = "Make a Donation";

    var loggedIn =
        User.Identity?.IsAuthenticated == true &&
        User.IsInRole("User");
}

<section class="donation-page">

    <div class="container">

        <div class="donation-header">

            <span class="hero-label">
                Support Our Work
            </span>

            <h1>
                Make a Donation
            </h1>

            <p>
                Your donation helps provide essential humanitarian
                assistance to communities in need.
            </p>

        </div>

        @if (!loggedIn)
        {
            <div class="alert alert-info">
                You are donating as a guest.
                Your donation will automatically be recorded as
                <strong>Anonymous</strong>.
                <a asp-controller="Account"
                   asp-action="Login">
                    Log in
                </a>
                if you would like the donation linked to your account.
            </div>
        }

        <div class="donation-card">

            <form asp-controller="Donation"
                  asp-action="Index"
                  method="post">

                @Html.AntiForgeryToken()

                <div asp-validation-summary="ModelOnly"
                     class="text-danger mb-3">
                </div>

                <h2>
                    How would you like to donate?
                </h2>

                <!-- DONATION TYPE -->

                <div class="donation-type">

                    <button type="button"
                            class="donation-type-btn active"
                            data-type="Once-off">

                        Once-off

                    </button>

                    <button type="button"
                            class="donation-type-btn"
                            data-type="Monthly">

                        Monthly

                    </button>

                </div>

                <input type="hidden"
                       id="donationType"
                       asp-for="DonationType" />

                <!-- CURRENCY -->

                <h3>
                    Donation currency
                </h3>

                <div class="currency-options">

                    <button type="button"
                            class="currency-btn active"
                            data-currency="ZAR">

                        ZAR
                        <span>
                            South African Rand
                        </span>

                    </button>

                    <button type="button"
                            class="currency-btn"
                            data-currency="USD">

                        USD
                        <span>
                            US Dollar
                        </span>

                    </button>

                    <button type="button"
                            class="currency-btn"
                            data-currency="EUR">

                        EUR
                        <span>
                            Euro
                        </span>

                    </button>

                </div>

                <input type="hidden"
                       id="donationCurrency"
                       asp-for="Currency" />

                <!-- AMOUNT -->

                <h3>
                    Select amount
                </h3>

                <div class="donation-amounts">

                    <button type="button"
                            class="amount-btn"
                            data-amount="100">
                        R100
                    </button>

                    <button type="button"
                            class="amount-btn"
                            data-amount="250">
                        R250
                    </button>

                    <button type="button"
                            class="amount-btn"
                            data-amount="500">
                        R500
                    </button>

                    <button type="button"
                            class="amount-btn"
                            data-amount="1000">
                        R1 000
                    </button>

                    <button type="button"
                            class="amount-btn"
                            data-amount="2500">
                        R2 500
                    </button>

                    <button type="button"
                            class="amount-btn"
                            id="customButton">
                        Custom
                    </button>

                </div>

                <input type="hidden"
                       id="donationAmount"
                       asp-for="Amount" />

                <span asp-validation-for="Amount"
                      class="text-danger">
                </span>

                <!-- CUSTOM AMOUNT -->

                <div class="custom-amount"
                     id="customAmountContainer">

                    <label for="customAmount">
                        Custom amount
                    </label>

                    <input type="number"
                           id="customAmount"
                           class="form-control"
                           min="1"
                           step="0.01"
                           placeholder="Enter amount" />

                </div>

                <!-- PAYMENT -->

                <h3>
                    Payment Method
                </h3>

                <div class="payment-methods">

                    <label class="payment-option">

                        <input type="radio"
                               asp-for="PaymentMethod"
                               value="Card" />

                        <span>
                            Credit / Debit Card
                        </span>

                    </label>

                    <label class="payment-option">

                        <input type="radio"
                               asp-for="PaymentMethod"
                               value="EFT" />

                        <span>
                            EFT
                        </span>

                    </label>

                </div>

                <!-- ANONYMOUS -->

                @if (loggedIn)
                {
                    <div class="anonymous-option">

                        <label>

                            <input type="checkbox"
                                   asp-for="IsAnonymous" />

                            <span>
                                Donate anonymously
                            </span>

                        </label>

                        <p>
                            Your name will not be displayed publicly
                            as a donor.
                        </p>

                    </div>
                }
                else
                {
                    <input type="hidden"
                           asp-for="IsAnonymous"
                           value="true" />

                    <div class="anonymous-option">

                        <label>

                            <input type="checkbox"
                                   checked
                                   disabled />

                            <span>
                                Anonymous donation
                            </span>

                        </label>

                        <p>
                            Guest donations are automatically anonymous.
                        </p>

                    </div>
                }

                <!-- SUMMARY -->

                <div class="donation-summary">

                    <div>

                        <span>
                            Donation
                        </span>

                        <strong id="summaryAmount">
                            R0
                        </strong>

                    </div>

                    <div>

                        <span>
                            Frequency
                        </span>

                        <strong id="summaryType">
                            Once-off
                        </strong>

                    </div>

                </div>

                <!-- BUTTON -->

                <div class="donation-action">

                    <button type="submit"
                            class="btn btn-donate-continue">

                        Continue

                    </button>

                </div>

            </form>

        </div>

    </div>

</section>

@section Scripts
{
    <partial name="_ValidationScriptsPartial" />

    <script>

        document.addEventListener(
            "DOMContentLoaded",
            function () {

                const typeButtons =
                    document.querySelectorAll(
                        ".donation-type-btn"
                    );

                const currencyButtons =
                    document.querySelectorAll(
                        ".currency-btn"
                    );

                const amountButtons =
                    document.querySelectorAll(
                        ".amount-btn"
                    );

                const donationType =
                    document.getElementById(
                        "donationType"
                    );

                const donationCurrency =
                    document.getElementById(
                        "donationCurrency"
                    );

                const donationAmount =
                    document.getElementById(
                        "donationAmount"
                    );

                const customButton =
                    document.getElementById(
                        "customButton"
                    );

                const customContainer =
                    document.getElementById(
                        "customAmountContainer"
                    );

                const customAmount =
                    document.getElementById(
                        "customAmount"
                    );

                const summaryAmount =
                    document.getElementById(
                        "summaryAmount"
                    );

                const summaryType =
                    document.getElementById(
                        "summaryType"
                    );


                // -----------------------------------------
                // DONATION TYPE
                // -----------------------------------------

                typeButtons.forEach(button => {

                    button.addEventListener(
                        "click",
                        function () {

                            typeButtons.forEach(
                                b =>
                                    b.classList.remove(
                                        "active"
                                    )
                            );

                            button.classList.add(
                                "active"
                            );

                            donationType.value =
                                button.dataset.type;

                            summaryType.textContent =
                                button.dataset.type;
                        }
                    );

                });


                // -----------------------------------------
                // CURRENCY
                // -----------------------------------------

                currencyButtons.forEach(button => {

                    button.addEventListener(
                        "click",
                        function () {

                            currencyButtons.forEach(
                                b =>
                                    b.classList.remove(
                                        "active"
                                    )
                            );

                            button.classList.add(
                                "active"
                            );

                            donationCurrency.value =
                                button.dataset.currency;

                            updateSummary();
                        }
                    );

                });


                // -----------------------------------------
                // PRESET AMOUNTS
                // -----------------------------------------

                amountButtons.forEach(button => {

                    button.addEventListener(
                        "click",
                        function () {

                            amountButtons.forEach(
                                b =>
                                    b.classList.remove(
                                        "active"
                                    )
                            );

                            button.classList.add(
                                "active"
                            );

                            if (
                                button.dataset.amount
                            ) {

                                donationAmount.value =
                                    button.dataset.amount;

                                customContainer
                                    .classList
                                    .remove("show");

                                updateSummary();
                            }
                        }
                    );

                });


                // -----------------------------------------
                // CUSTOM AMOUNT
                // -----------------------------------------

                customButton.addEventListener(
                    "click",
                    function () {

                        amountButtons.forEach(
                            b =>
                                b.classList.remove(
                                    "active"
                                )
                        );

                        customButton.classList.add(
                            "active"
                        );

                        customContainer
                            .classList
                            .add("show");

                        customAmount.focus();
                    }
                );


                customAmount.addEventListener(
                    "input",
                    function () {

                        donationAmount.value =
                            customAmount.value;

                        updateSummary();
                    }
                );


                // -----------------------------------------
                // SUMMARY
                // -----------------------------------------

                function updateSummary()
                {
                    const amount =
                        parseFloat(
                            donationAmount.value
                        ) || 0;

                    const currency =
                        donationCurrency.value;

                    let symbol = "R";

                    if (currency === "USD")
                    {
                        symbol = "$";
                    }
                    else if (currency === "EUR")
                    {
                        symbol = "€";
                    }

                    summaryAmount.textContent =
                        symbol +
                        amount.toLocaleString(
                            undefined,
                            {
                                minimumFractionDigits: 2,
                                maximumFractionDigits: 2
                            }
                        );
                }

            }
        );

    </script>
}