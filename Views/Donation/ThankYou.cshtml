@* Confirmation shown after a donation is received. *@
@{
    ViewData["Title"] = "Thank You";
    var certificateNumber = TempData.Peek("CertificateNumber") as string;
    var certificateError = TempData.Peek("CertificateError") as string;
}

<section class="thank-you-page">
    <div class="container">

        <div class="thank-you-card">

            <div class="thank-you-icon">
                ✓
            </div>

            <span class="hero-label">Donation Received</span>

            <h1>Thank You!</h1>

            <p class="thank-you-message">
                Thank you for supporting Gift of the Givers.
                Your contribution will help provide humanitarian
                assistance to communities in need.
            </p>

            <p class="thank-you-small">
                Every contribution makes a difference.
            </p>

            @if (!string.IsNullOrWhiteSpace(certificateNumber))
            {
                <p class="thank-you-small">
                    Your tax certificate number is <strong>@certificateNumber</strong>.
                </p>
            }
            else if (!string.IsNullOrWhiteSpace(certificateError))
            {
                <p class="thank-you-small text-warning">
                    @certificateError
                </p>
            }

            <div class="thank-you-buttons">

                <a asp-controller="Home"
                   asp-action="Index"
                   class="btn btn-donate-continue">
                    Back to Home
                </a>

                <a asp-controller="Donation"
                   asp-action="Index"
                   class="btn btn-thank-you-outline">
                    Make Another Donation
                </a>

                @if (ViewBag.DonationId is int donationId &&
                     User.IsInRole("User") &&
                     !string.IsNullOrWhiteSpace(certificateNumber))
                {
                    <a asp-controller="Donation"
                       asp-action="Certificate"
                       asp-route-id="@donationId"
                       class="btn btn-thank-you-outline">
                        View Tax Certificate
                    </a>
                }

            </div>

        </div>

    </div>
</section>