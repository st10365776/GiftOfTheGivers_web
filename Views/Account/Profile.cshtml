@model GiftOfTheGivers_web.Models.User

@{
    ViewData["Title"] = "My Profile";

    var initials = string.Join(
        "",
        (Model.FullName ?? "U")
            .Split(
                ' ',
                StringSplitOptions.RemoveEmptyEntries)
            .Take(2)
            .Select(x => x[0])
    ).ToUpperInvariant();

    var donations =
        Model.Donations?
            .OrderByDescending(d => d.DonationDate)
            .ToList()
        ?? new List<GiftOfTheGivers_web.Models.Donation>();

    var totalDonated =
        donations
            .Where(d => d.Status != "Cancelled")
            .Sum(d => d.Amount);
}

<section class="profile-page">

    <div class="container">

        @if (TempData["ProfileMessage"] != null)
        {
            <div class="alert alert-success">
                @TempData["ProfileMessage"]
            </div>
        }

        @if (TempData["VolunteerMessage"] != null)
        {
            <div class="alert alert-info">
                @TempData["VolunteerMessage"]
            </div>
        }

        <div class="profile-header">

            <span class="hero-label">
                Account
            </span>

            <h1>
                My Profile
            </h1>

            <p>
                Manage your account information,
                donations and volunteer activity.
            </p>

        </div>

        <div class="row g-4">

            <!-- USER -->

            <div class="col-lg-4">

                <div class="profile-card profile-user-card">

                    <div class="profile-avatar">
                        @initials
                    </div>

                    <h2>
                        @Model.FullName
                    </h2>

                    <p class="profile-email">
                        @Model.Email
                    </p>

                    <span class="profile-status">
                        Active Account
                    </span>

                </div>

            </div>

            <!-- PERSONAL INFORMATION -->

            <div class="col-lg-8">

                <div class="profile-card">

                    <div class="profile-card-header">

                        <div>

                            <span class="profile-section-label">
                                Personal Information
                            </span>

                            <h2>
                                Account Details
                            </h2>

                        </div>

                    </div>

                    <form asp-controller="Account"
                          asp-action="Profile"
                          method="post">

                        @Html.AntiForgeryToken()

                        <div asp-validation-summary="ModelOnly"
                             class="text-danger mb-3">
                        </div>

                        <div class="row g-3">

                            <div class="col-md-6">

                                <label asp-for="FullName"
                                       class="form-label">
                                    Full Name
                                </label>

                                <input asp-for="FullName"
                                       class="form-control" />

                                <span asp-validation-for="FullName"
                                      class="text-danger">
                                </span>

                            </div>

                            <div class="col-md-6">

                                <label asp-for="Email"
                                       class="form-label">
                                    Email
                                </label>

                                <input asp-for="Email"
                                       type="email"
                                       class="form-control" />

                                <span asp-validation-for="Email"
                                      class="text-danger">
                                </span>

                            </div>

                            <div class="col-md-6">

                                <label asp-for="PhoneNumber"
                                       class="form-label">
                                    Phone
                                </label>

                                <input asp-for="PhoneNumber"
                                       class="form-control" />

                                <span asp-validation-for="PhoneNumber"
                                      class="text-danger">
                                </span>

                            </div>

                        </div>

                        <button type="submit"
                                class="btn btn-donate mt-4">

                            Save Changes

                        </button>

                    </form>

                </div>

            </div>

        </div>

        <!-- ACTIVITY -->

        <div class="profile-card activity-card mt-4">

            <div class="profile-card-header">

                <div>

                    <span class="profile-section-label">
                        Your Activity
                    </span>

                    <h2>
                        Account Overview
                    </h2>

                </div>

            </div>

            <div class="row g-4">

                <div class="col-md-4">

                    <div class="profile-stat">

                        <div class="profile-stat-number">
                            @donations.Count
                        </div>

                        <div class="profile-stat-label">
                            Donations Made
                        </div>

                    </div>

                </div>

                <div class="col-md-4">

                    <div class="profile-stat">

                        <div class="profile-stat-number">
                            @totalDonated.ToString("C2")
                        </div>

                        <div class="profile-stat-label">
                            Total Donated
                        </div>

                    </div>

                </div>

                <div class="col-md-4">

                    <div class="profile-stat">

                        <div class="profile-stat-number">
                            @(Model.Volunteer == null ? "0" : "1")
                        </div>

                        <div class="profile-stat-label">
                            Volunteer Application
                        </div>

                    </div>

                </div>

            </div>

        </div>

        <!-- QUICK ACTIONS -->

        <div class="profile-card mt-4">

            <div class="profile-card-header">

                <div>

                    <span class="profile-section-label">
                        Account Management
                    </span>

                    <h2>
                        Quick Actions
                    </h2>

                </div>

            </div>

            <div class="profile-actions">

                <a asp-controller="Donation"
                   asp-action="History"
                   class="profile-action">

                    <div>

                        <strong>
                            Donation History
                        </strong>

                        <span>
                            View your previous donations
                        </span>

                    </div>

                    <span class="profile-arrow">
                        →
                    </span>

                </a>

                <a asp-controller="Donation"
                   asp-action="Index"
                   class="profile-action">

                    <div>

                        <strong>
                            Make a Donation
                        </strong>

                        <span>
                            Support humanitarian relief
                        </span>

                    </div>

                    <span class="profile-arrow">
                        →
                    </span>

                </a>

                @if (Model.Volunteer == null)
                {
                    <a asp-controller="Volunteer"
                       asp-action="Apply"
                       class="profile-action">

                        <div>

                            <strong>
                                Volunteer
                            </strong>

                            <span>
                                Get involved and help communities
                            </span>

                        </div>

                        <span class="profile-arrow">
                            →
                        </span>

                    </a>
                }
                else
                {
                    <div class="profile-action">

                        <div>

                            <strong>
                                Volunteer Application
                            </strong>

                            <span>
                                Status:
                                @Model.Volunteer.Status
                            </span>

                        </div>

                        <span class="profile-status">
                            @Model.Volunteer.Status
                        </span>

                    </div>
                }

                <form asp-controller="Account"
                      asp-action="Logout"
                      method="post"
                      class="m-0">

                    @Html.AntiForgeryToken()

                    <button type="submit"
                            class="profile-action profile-logout w-100 text-start border-0">

                        <div>

                            <strong>
                                Log Out
                            </strong>

                            <span>
                                Sign out of your account
                            </span>

                        </div>

                        <span class="profile-arrow">
                            →
                        </span>

                    </button>

                </form>

            </div>

        </div>

    </div>

</section>