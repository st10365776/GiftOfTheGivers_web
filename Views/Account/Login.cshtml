@* Login form for returning users. *@
@{
    ViewData["Title"] = "Login";
}

<link rel="stylesheet" href="~/css/login.css" />

<div class="login-page">

    <div class="login-hero">

        <div class="hero-overlay"></div>

        <div class="hero-content">

            <div class="hero-logo">
                <i class="bi bi-heart-fill"></i>
            </div>

            <h1>
                Helping People. <br />Changing Lives
            </h1>

            <p>
                Supporting communities and bringing hope to people
                affected by disasters and difficult situations.
            </p>

            <div class="hero-stat">
                <i class="bi bi-people-fill"></i>
                <span>Together, we can make a difference.</span>
            </div>

        </div>

    </div>


    <div class="login-section">

        <div class="login-card">

            <div class="login-icon">
                <i class="bi bi-person-circle"></i>
            </div>

            <h2>Welcome Back</h2>

            <p class="login-subtitle">
                Sign in to continue to your account
            </p>


            @* Display login errors *@
            <div asp-validation-summary="All"
                 class="text-danger">
            </div>


            <!-- LOGIN FORM -->
            <form asp-controller="Account"
                  asp-action="Login"
                  method="post">

                @Html.AntiForgeryToken()


                @* EMAIL *@
                <div class="input-group-custom">

                    <label for="email">
                        Email Address
                    </label>

                    <div class="input-wrapper">

                        <i class="bi bi-envelope"></i>

                        <input type="email"
                               id="email"
                               name="email"
                               placeholder="Enter your email"
                               required />

                    </div>

                </div>


                @* PASSWORD *@
                <div class="input-group-custom">

                    <label for="password">
                        Password
                    </label>

                    <div class="input-wrapper">

                        <i class="bi bi-lock"></i>

                        <input type="password"
                               id="password"
                               name="password"
                               placeholder="Enter your password"
                               required />

                        <button type="button"
                                class="password-toggle"
                                onclick="togglePassword()">

                            <i class="bi bi-eye"
                               id="eyeIcon"></i>

                        </button>

                    </div>

                </div>


                @* REMEMBER / FORGOT *@
                <div class="login-options">

                    <label class="remember-me">

                        <input type="checkbox"
                               name="rememberMe"
                               value="true" />

                        <span>Remember me</span>

                    </label>

                    <a href="#"
                       class="forgot-password">

                        Forgot password?

                    </a>

                </div>


                @* LOGIN BUTTON *@
                <button type="submit"
                        class="login-btn">

                    <span>Login</span>

                    <i class="bi bi-arrow-right"></i>

                </button>

            </form>


            @* REGISTER LINK *@
            <div class="register-text">

                Don't have an account?

                <a asp-controller="Account"
                   asp-action="Register">

                    Create an account

                </a>

            </div>


            @* QUICK LINKS *@
            <div class="quick-links">

                <a asp-controller="Home"
                   asp-action="Index">

                    <i class="bi bi-house"></i>
                    Home

                </a>

                <span>|</span>

                <a asp-controller="Account"
                   asp-action="Profile">

                    <i class="bi bi-person"></i>
                    Profile

                </a>

            </div>

        </div>

    </div>

</div>


<script>

    function togglePassword() {

        const password =
            document.getElementById("password");

        const eyeIcon =
            document.getElementById("eyeIcon");


        if (password.type === "password") {

            password.type = "text";

            eyeIcon.classList.remove("bi-eye");

            eyeIcon.classList.add("bi-eye-slash");

        }
        else {

            password.type = "password";

            eyeIcon.classList.remove("bi-eye-slash");

            eyeIcon.classList.add("bi-eye");

        }

    }

</script>